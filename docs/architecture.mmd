    subgraph routers["routers/"]
      R_MISC["misc.py — /, /healthz, /api/version, /api/system/load, /api/system/health, /api/system/restart"]
      R_AUTH["auth.py — /api/login"]
      R_CONFIG["config.py — /api/config, /api/status, /api/ports"]
