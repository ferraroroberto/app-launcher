      R_CC["claude_code.py — favorites, flags, git-status, VS Code open"]
      R_TRANSCRIPT["session_transcript.py — /api/claude-code/sessions/{sid}/transcript\npaginated typed transcript page (#953)\n+ session_outbox_routes.py (agent-sent files, #1530)\n+ /background-tasks (a Claude session's launched tasks and their output tail)
+ /links (every URL a session mentioned, grouped)"]
      R_SCREEN["session_screen.py — /api/claude-code/sessions/{sid}/answer, plan-picker,
resume, context
reads the PTY screen + types keystrokes (#1424)"]
      R_DESKTOP["desktop_screen.py — /api/screen/monitors, WS /api/screen/ws\nthe PC desktop, live, passkey-gated (#1520)\n+ click / drag / scroll / type on the same socket (#1521)"]
      R_JOBS["jobs.py + jobs_run_store_routes.py\n+ jobs_webhook_routes.py\n/api/jobs/* (Jobs tab)"]
      R_LIFEOS["life_os.py — /api/life-os/* (Life OS tab) launch\n+ life_os_conversations.py (history index/relaunch)\n+ life_os_search.py (cross-skill conversation search)\n+ life_os_files.py (path-jailed content browser,
  /file/transcript: capture parsed to Chat entries)\n+ life_os_spawn.py (shared skill resolve + spawn tail)
+ life_os_channels.py (Telegram channel profiles, #1366)
+ life_os_relay.py (a profile's bot finds, resumes, steers its skill's conversations, #1639)
(its Delete runs src/life_os/delete.py, shared with the life-os-zombie-cleanup CLI + nightly Job, #1738)
+ life_os_archived.py (the zombie cleanup's archive: list, read, restore)"]
      R_BOARD["board.py — /api/board (Board tab) + issue start\n+ board_chief.py (fleet-chief ensure/settings, #245)\n+ board_spawn.py (shared spawn-then-type)
+ board_owner.py (owner-check answers)"]
      R_WEBAUTHN["webauthn.py — passkey ceremonies"]
      R_USAGE["src/usage_log.py (vendored) — /api/usage\nlocal view/tap log, runtime-data SQLite (#1524)"]
      R_SCREENTIME["screen_time.py — /api/screen-time/export\nSend to task-os via src/usage/export.py\n(also the usage-export CLI + nightly Job, #1678)"]
      R_PERF["perf_timings.py — /api/perf/timings + /api/perf/summary
real-device load + slow-API timings via src/usage/perf_timings.py
(also the perf-summary CLI)"]    end
  end
